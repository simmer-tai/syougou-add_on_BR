{
    "namespace": "hud",
    "personal_sidebar_panel": {
        "type": "panel",
        "size": [ 100, "100%c" ],
        "anchor_from": "right_middle",
        "anchor_to": "right_middle",
        "offset": [ -8, 0 ],
        "controls": [
            {
                "background": {
                    "type": "image",
                    "texture": "textures/ui/black_background",
                    "alpha": 0.4,
                    "size": [ "100% + 12px", "100% + 14px" ],
                    "layer": -1
                }
            },
            {
                "subtitle_label": {
                    "type": "label",
                    "text": "#text",
                    "bindings": [
                        {
                            "binding_name": "#subtitle_text",
                            "binding_name_override": "#text"
                        }
                    ],
                    "shadow": true,
                    "font_scale_factor": 1.0,
                    "anchor_from": "top_left",
                    "anchor_to": "top_left",
                    "offset": [ 2, 0 ]
                }
            }
        ]
    },

   
    "hud_screen@hud.hud_screen": {
        "modifications": [
            {
                "array_name": "controls",
                "operation": "insert_back",
                "value": [
                    {
                        "personal_sidebar_panel@hud.personal_sidebar_panel": {
                            "layer": 50
                        }
                    }
                ]
            }
        ]
    }
}